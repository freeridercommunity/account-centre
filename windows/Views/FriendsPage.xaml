<Page x:Class="AccountCentre.Views.FriendsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="using:AccountCentre.Models"
	xmlns:converters="using:AccountCentre.Converters">
	<Page.Resources>
		<converters:FriendActivityToStatusStyleConverter x:Key="FriendActivityToStatusStyleConverter"/>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- <RowDefinition Height="Auto"/> -->
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Padding="32,32,32,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Spacing="4">
				<TextBlock Text="Friends" Style="{StaticResource TitleTextBlockStyle}"/>
				<TextBlock x:Name="FriendCount"
					Text="0 friends"
					Opacity="0.7"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal"
				Grid.Column="1"
				Spacing="8"
				VerticalAlignment="Top">
				<Button Style="{StaticResource SubtleButtonStyle}"
					Click="OpenFriendRequestsDialog_Click">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE716;"/>
						<TextBlock Text="Requests"/>
					</StackPanel>
				</Button>

				<Button Style="{StaticResource AccentButtonStyle}"
					Click="OpenAddFriendDialog_Click">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon Glyph="&#xE8FA;"/>
						<TextBlock Text="Add Friend"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<!-- <InfoBar x:Name="ErrorInfoBar"
			Grid.Row="1"
			Title="Something went wrong"
			Message="An error has occurred."
			Margin="32,12"
			Severity="Error"
			IsOpen="False"
			IsClosable="True"/>

		<InfoBar x:Name="FriendRequestSentInfoBar"
			Grid.Row="1"
			Title="Friend Request Sent"
			Message="The friend request was sent successfully."
			Margin="32,12"
			Severity="Success"
			IsOpen="False"
			IsClosable="True"/> -->

		<RefreshContainer Grid.Row="1" x:Name="RefreshContainer"
			RefreshRequested="RefreshContainer_RefreshRequested">
			<ScrollViewer Padding="32,16">
				<ItemsRepeater ItemsSource="{x:Bind Friends, Mode=OneWay}">
					<ItemsRepeater.Layout>
						<StackLayout Spacing="8"/>
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate x:DataType="models:Friend">
							<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								CornerRadius="8" Padding="16">
								<Border.Resources>
									<MenuFlyout x:Name="FriendMenu">
										<MenuFlyoutItem Text="View profile" Click="ViewProfile_Click">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE8A7;"/>
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>

										<MenuFlyoutSeparator/>

										<MenuFlyoutItem Text="Remove"
											Foreground="{ThemeResource SystemFillColorCriticalBrush}"
											Click="RemoveFriend_Click">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xF69B;"/>
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>
									</MenuFlyout>
								</Border.Resources>
								<Border.ContextFlyout>
									<StaticResource ResourceKey="FriendMenu"/>
								</Border.ContextFlyout>

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel Orientation="Horizontal" Spacing="16">
										<Grid>
											<PersonPicture ProfilePicture="{Binding DisplayAvatarURL, FallbackValue='ms-appx:///Assets/default-avatar.png', TargetNullValue='ms-appx:///Assets/default-avatar.png'}"
												CornerRadius="20"
												Height="40"
												VerticalAlignment="Center"
												Width="40"/>

											<InfoBadge Style="{Binding ActivityTimestamp, Converter={StaticResource FriendActivityToStatusStyleConverter}}"
												Height="12"
												HorizontalAlignment="Right"
												VerticalAlignment="Bottom"
												Width="12"
												ToolTipService.ToolTip="{Binding ActivityTimeAgo}"/>
										</Grid>

										<StackPanel
											Grid.Column="1"
											Spacing="3"
											VerticalAlignment="Center">
											<TextBlock
												Text="{Binding DisplayName}"
												FontSize="15"
												FontWeight="SemiBold"/>

											<TextBlock
												Text="{Binding ActivityTimeAgo}"
												FontSize="12"
												Opacity="0.6"/>
										</StackPanel>
									</StackPanel>

									<StackPanel
										Grid.Column="2"
										Orientation="Horizontal"
										Spacing="12"
										VerticalAlignment="Center">
										<Button Flyout="{StaticResource FriendMenu}"
											Style="{StaticResource SubtleButtonStyle}">
											<FontIcon Glyph="&#xE712;"/>
										</Button>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</ScrollViewer>
		</RefreshContainer>
	</Grid>
</Page>