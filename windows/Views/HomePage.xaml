<Page x:Class="AccountCentre.Views.HomePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Padding="32,32,32,12" Spacing="4">
			<TextBlock
				Text="Home"
				FontSize="32"
				FontWeight="SemiBold" />

			<TextBlock
				Text="Manage your Free Rider HD account and content."
				Opacity="0.7"/>
		</StackPanel>

		<ScrollViewer Grid.Row="1">
			<GridView
				IsItemClickEnabled="True"
				Padding="32"
				SelectionMode="None"
				HorizontalAlignment="Stretch">

				<Grid
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					CornerRadius="12"
					Padding="24"
					Width="300"
					Height="120"
					ColumnSpacing="16">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<FontIcon Glyph="&#xE70F;" FontSize="28"/>

					<StackPanel
						Grid.Column="1"
						Padding="12"
						Spacing="4"
						VerticalAlignment="Center">

						<TextBlock
							Text="Remove a track"
							FontSize="16"
							FontWeight="SemiBold"/>

						<TextBlock
							Text="Remove one of your tracks."
							TextWrapping="Wrap"
							Opacity="0.7"/>
					</StackPanel>

				</Grid>

				<Grid
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					CornerRadius="12"
					Padding="24"
					Width="300"
					Height="120"
					ColumnSpacing="16">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<FontIcon Glyph="&#xE7FC;" FontSize="28"/>

					<StackPanel
						Grid.Column="1"
						Padding="12"
						Spacing="4"
						VerticalAlignment="Center">

						<TextBlock
							Text="Remove a race"
							FontSize="16"
							FontWeight="SemiBold"/>

						<TextBlock
							Text="Permanently remove a race from your account."
							TextWrapping="Wrap"
							Opacity="0.7" />
					</StackPanel>

				</Grid>

				<Grid
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					CornerRadius="12"
					Padding="24"
					Width="300"
					Height="120"
					ColumnSpacing="16">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<FontIcon Glyph="&#xE715;" FontSize="28"/>

					<StackPanel
						Grid.Column="1"
						Padding="12"
						Spacing="4"
						VerticalAlignment="Center">

						<TextBlock
							Text="Change email"
							FontSize="16"
							FontWeight="SemiBold" />

						<TextBlock
							Text="Update the email address associated with your account."
							TextWrapping="Wrap"
							Opacity="0.7" />
					</StackPanel>

				</Grid>

				<Grid
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					CornerRadius="12"
					Padding="24"
					Width="300"
					Height="120"
					ColumnSpacing="16">

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<FontIcon Glyph="&#xE77B;" FontSize="28"/>

					<StackPanel
						Grid.Column="1"
						Padding="12"
						Spacing="4"
						VerticalAlignment="Center">

						<TextBlock
							Text="Change username"
							FontSize="16"
							FontWeight="SemiBold"/>

						<TextBlock
							Text="Change the username displayed on your account."
							TextWrapping="Wrap"
							Opacity="0.7"/>
					</StackPanel>

				</Grid>
			</GridView>
		</ScrollViewer>
	</Grid>
</Page>