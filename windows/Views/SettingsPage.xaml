<Page x:Class="AccountCentre.Views.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls">
	<Grid MaxWidth="1130" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" Padding="32,32,32,0"/>
		<ScrollView Grid.Row="1" Padding="32,0,32,32">
			<StackPanel Spacing="4">
				<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
					<Grid Background="Transparent"
						Height="48"
						Width="48"
						PointerEntered="EditRow_Entered"
						PointerExited="EditRow_Exited">
						<PersonPicture ProfilePicture="{x:Bind Session.User.DisplayAvatarURL, Mode=OneWay}"
							Height="48"
							Margin="0"
							Width="48"/>
						<Button CornerRadius="24"
							HorizontalAlignment="Stretch"
							Opacity="0"
							Padding="14"
							VerticalAlignment="Stretch"
							Click="ChangeAvatar_Click">
							<Button.Resources>
								<SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#80000000"/>
								<SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#a0000000"/>
							</Button.Resources>
							<Viewbox Stretch="Uniform">
								<FontIcon Glyph="&#xE70F;"/>
							</Viewbox>
						</Button>
					</Grid>
					<StackPanel VerticalAlignment="Center">
						<Grid Background="Transparent"
							ColumnSpacing="8"
							PointerEntered="EditRow_Entered"
							PointerExited="EditRow_Exited">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{x:Bind Session.User.DisplayName}" FontSize="24"/>
							<Button Grid.Column="1" x:Name="NameChangeButton"
								Style="{StaticResource SubtleButtonStyle}"
								Opacity="0"
								Padding="8,0"
								VerticalAlignment="Center"
								IsEnabled="False"
								Click="ChangeUsername_Click">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Viewbox Stretch="Uniform">
										<FontIcon Glyph="&#xE70F;" FontSize="14"/>
									</Viewbox>
									<TextBlock FontSize="14">
										<Run x:Name="NameChangesRemaining">0</Run> Remaining
									</TextBlock>
								</StackPanel>
							</Button>
						</Grid>

						<Grid Background="Transparent"
							ColumnSpacing="8"
							PointerEntered="EditRow_Entered"
							PointerExited="EditRow_Exited">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{x:Bind Session.User.Email}" Foreground="DarkGray"/>
							<Button Grid.Column="1"
								Style="{StaticResource SubtleButtonStyle}"
								Opacity="0"
								Padding="8,0"
								VerticalAlignment="Stretch"
								Click="ChangeEmail_Click">
								<Viewbox Stretch="Uniform">
									<FontIcon Glyph="&#xE70F;" FontSize="14"/>
								</Viewbox>
							</Button>
						</Grid>
					</StackPanel>
				</StackPanel>

				<TextBlock Text="Account" Style="{StaticResource SubtitleTextBlockStyle}"/>
				<controls:SettingsCard Header="Change password"
					Description="Change the password used to sign in">
					<Button Style="{StaticResource AccentButtonStyle}"
						Content="Change password"
						Click="ChangePassword_Click"/>
				</controls:SettingsCard>

				<controls:SettingsCard Header="Update forum password"
					Description="Change the password used to sign into forums">
					<Button Style="{StaticResource AccentButtonStyle}"
						Content="Update forum password"
						Click="UpdateForumPassword_Click"/>
				</controls:SettingsCard>

				<controls:SettingsCard Header="Sign out everywhere"
					Description="Sign out of your account on all devices with active sessions">
					<Button Style="{StaticResource AccentButtonStyle}"
						Content="Sign out"
						Click="ClearSessions_Click"/>
				</controls:SettingsCard>

				<TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}"/>
				<controls:SettingsCard Header="Allow multiple sessions"
					Description="Choose whether to allow running concurrent app instances">
					<ToggleSwitch IsOn="{x:Bind Settings.AllowConcurrentSessions, Mode=TwoWay}"/>
				</controls:SettingsCard>

				<controls:SettingsCard Header="Minimize to tray"
					Description="Minimize to system tray when the application is closed"
					IsEnabled="False">
					<ToggleSwitch IsOn="{x:Bind Settings.MinimizeToTray, Mode=TwoWay}"/>
				</controls:SettingsCard>

				<controls:SettingsCard Header="Remember users"
					Description="Save user login information">
					<ToggleSwitch IsOn="{x:Bind Settings.SaveLoginInfo, Mode=TwoWay}" IsEnabled="False"/>
				</controls:SettingsCard>

				<controls:SettingsCard Header="Startup account behaviour"
					Description="Choose whether to automatically sign in to your last used account or select an account on startup">
					<ComboBox SelectedIndex="{x:Bind StartupAccountBehaviorIndex, Mode=TwoWay}">
						<ComboBoxItem Content="Last used"/>
						<ComboBoxItem Content="Always ask"/>
					</ComboBox>
				</controls:SettingsCard>

				<controls:SettingsExpander Header="Advanced">
					<controls:SettingsExpander.Items>
						<controls:SettingsCard x:Name="ClearCacheCard" Header="Clear cache">
							<controls:SettingsCard.Description>
								<TextBlock>
									Delete cached thumbnails, user data, and other app data.
									Size: <Run x:Name="CacheDirectorySize">0</Run>
								</TextBlock>
							</controls:SettingsCard.Description>
							<Button Content="Clear cache" Click="ClearCache_Click"/>
						</controls:SettingsCard>

						<controls:SettingsCard Header="Developer mode">
							<ToggleSwitch IsOn="{x:Bind Settings.DeveloperMode, Mode=TwoWay}"/>
						</controls:SettingsCard>

						<controls:SettingsCard Header="WAF Passthrough"
							Description="Attempt to pass through the web application firewall">
							<ToggleSwitch IsOn="{x:Bind Settings.WAFPassthrough, Mode=TwoWay}"/>
						</controls:SettingsCard>

						<controls:SettingsCard x:Name="ClearTempCard" Header="Remove temporary files">
							<controls:SettingsCard.Description>
								<TextBlock>
									Remove files that were automatically generated by the app.
									Size: <Run x:Name="TempDirectorySize">0</Run>
								</TextBlock>
							</controls:SettingsCard.Description>
							<Button Content="Remove files" Click="ClearTempFiles_Click"/>
						</controls:SettingsCard>
					</controls:SettingsExpander.Items>
				</controls:SettingsExpander>

				<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About"/>

				<Grid>
					<InfoBar x:Name="UpdateStatusBar" x:Uid="Update_UpToDate"
						IsClosable="False" IsOpen="True" Severity="Success">

						<InfoBar.ActionButton>
							<Button x:Name="DownloadUpdateButton" Style="{StaticResource SubtleButtonStyle}"
								Content="Download" HorizontalAlignment="Right" Visibility="Collapsed"
								Tag="Download" Click="DownloadUpdate_Click"/>
						</InfoBar.ActionButton>
					</InfoBar>
					<ProgressBar x:Name="UpdateProgressBar" IsIndeterminate="True"
						Margin="4,0" HorizontalAlignment="Stretch"
						VerticalAlignment="Bottom" Visibility="Collapsed"/>
				</Grid>

				<controls:SettingsExpander Header="Free Rider Community Account Centre">
					<controls:SettingsExpander.HeaderIcon>
						<ImageIcon Source="ms-appx:///Assets/app.ico"/>
					</controls:SettingsExpander.HeaderIcon>
					<controls:SettingsExpander.Description>
						<TextBlock>
							<Span>By <Span Foreground="DarkGray">@</Span></Span><Hyperlink NavigateUri="https://frhd.co/u/calculus">
								<Bold>Calculus</Bold>
							</Hyperlink><Span>, for the community.</Span>
						</TextBlock>
					</controls:SettingsExpander.Description>

					<TextBlock x:Name="Version" Text="Unknown"
						IsTextSelectionEnabled="True"
						VerticalAlignment="Center"/>

					<controls:SettingsExpander.Items>
						<controls:SettingsCard Header="Update channel"
							Description="Choose which versions you receive">
							<ComboBox SelectedIndex="{x:Bind UpdateChannelIndex, Mode=TwoWay}">
								<ComboBoxItem Content="Stable"/>
								<ComboBoxItem Content="Beta"/>
							</ComboBox>
						</controls:SettingsCard>
						<controls:SettingsCard x:Name="CheckForUpdatesCard" Header="Update">
							<Button x:Name="CheckForUpdatesButton" Style="{StaticResource AccentButtonStyle}"
								Content="Check for updates" Click="CheckForUpdates_Click"/>
						</controls:SettingsCard>
						<controls:SettingsCard Header="Check for updates" Description="Automatically check for updates on startup">
							<ToggleSwitch IsOn="{x:Bind Settings.CheckForUpdatesAtStartup, Mode=TwoWay}"/>
						</controls:SettingsCard>
						<controls:SettingsCard Header="Download automatically" Description="Automatically download the latest update on startup">
							<ToggleSwitch IsOn="{x:Bind Settings.AutoDownloadUpdates, Mode=TwoWay}"/>
						</controls:SettingsCard>
						<controls:SettingsCard>
							<controls:SettingsCard.Header>
								<StackPanel>
									<HyperlinkButton Content="GitHub Repository" NavigateUri="https://github.com/freeridercommunity/account-centre"/>
									<HyperlinkButton Content="Latest Release" NavigateUri="https://github.com/freeridercommunity/account-centre/releases/latest"/>
								</StackPanel>
							</controls:SettingsCard.Header>
						</controls:SettingsCard>
					</controls:SettingsExpander.Items>
				</controls:SettingsExpander>
			</StackPanel>
		</ScrollView>
	</Grid>
</Page>