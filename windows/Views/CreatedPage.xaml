<Page x:Class="AccountCentre.Views.CreatedPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="using:AccountCentre.Models"
	xmlns:converters="using:AccountCentre.Converters">
	<Page.Resources>
		<!-- <converters:TrackVisibilityToBackgroundConverter x:Key="TrackVisibilityToBackgroundConverter"/> -->
		<converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
		<ItemsPanelTemplate x:Key="TracksGridPanel">
			<ItemsWrapGrid
				Orientation="Horizontal"
				MaximumRowsOrColumns="4"
			/>
		</ItemsPanelTemplate>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid Padding="32,32,32,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Spacing="4">
				<TextBlock Text="Created" Style="{StaticResource TitleTextBlockStyle}"/>
				<TextBlock x:Name="TrackCount"
					Text="0 tracks"
					Opacity="0.7"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal"
				Grid.Column="1"
				HorizontalAlignment="Right"
				Spacing="8"
				VerticalAlignment="Top">

				<CheckBox x:Name="OptionsAllCheckBox" IsThreeState="True"
					Grid.Column="1"
					Content="Select all"
					Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"
					Indeterminate="SelectAll_Indeterminate"/>

				<DropDownButton x:Name="BulkAction" Content="0 selected" IsEnabled="False" Visibility="Collapsed">
					<DropDownButton.Flyout>
						<MenuFlyout Placement="Bottom">
							<SplitMenuFlyoutItem Text="Copy" Tag="Copy" Click="BulkAction_Click">
								<SplitMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8C8;"/>
								</SplitMenuFlyoutItem.Icon>

								<MenuFlyoutItem Text="Copy as zip" Tag="CopyAsZip" Click="BulkAction_Click">
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xF012;"/>
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
							</SplitMenuFlyoutItem>

							<MenuFlyoutItem Text="Download"
								Tag="Download"
								Click="BulkAction_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE896;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

							<MenuFlyoutSeparator/>

							<MenuFlyoutItem Text="Delete"
								Foreground="{ThemeResource SystemFillColorCriticalBrush}"
								IsEnabled="False">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</DropDownButton.Flyout>
				</DropDownButton>

				<!-- Move to titlebar -->
				<Button ToolTipService.ToolTip="Filter" Visibility="{x:Bind CanFilter}">
					<FontIcon Glyph="&#xE71C;"/>
					<Button.Flyout>
						<MenuFlyout Placement="Bottom">
							<ToggleMenuFlyoutItem Text="Featured" IsEnabled="{x:Bind HasFeature}">
								<ToggleMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF4A5;"/>
								</ToggleMenuFlyoutItem.Icon>
							</ToggleMenuFlyoutItem>
							<ToggleMenuFlyoutItem Text="Hidden" IsEnabled="{x:Bind HasHidden}">
								<ToggleMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xED1A;"/>
								</ToggleMenuFlyoutItem.Icon>
							</ToggleMenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>

			</StackPanel>

			<InfoBar x:Name="BulkActionStatusBar"
				Grid.Column="1"
				IsOpen="False"
				Severity="Success"
				Message="Text copied to clipboard"
				IsClosable="True"/>
		</Grid>

		<RefreshContainer x:Name="RefreshContainer"
			Grid.Row="2"
			RefreshRequested="RefreshContainer_RefreshRequested">

			<GridView x:Name="TracksGrid"
				ItemsSource="{x:Bind Tracks}"
				Padding="32,16"
				SelectionMode="Multiple"
				IsItemClickEnabled="False"
				SelectionChanged="TracksGrid_SelectionChanged"
				ContainerContentChanging="TracksGrid_ContainerContentChanging">
				<GridView.ItemTemplate>
					<DataTemplate x:DataType="models:CreatedTrack">

						<Border
							Width="260"
							CornerRadius="8"
							Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
							<Border.Resources>
								<MenuFlyout x:Name="TrackMenu">

									<MenuFlyoutItem Text="View track" Click="ViewTrack_Click"
										Visibility="{Binding IsHidden, Converter={StaticResource InvertBoolConverter}}">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE8A7;"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>

									<SplitMenuFlyoutItem Text="Copy" Tag="Plain" Click="CopyTrack_Click"
										Visibility="{Binding IsHidden, Converter={StaticResource InvertBoolConverter}}">
										<SplitMenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE8C8;"/>
										</SplitMenuFlyoutItem.Icon>

										<MenuFlyoutItem Text="Copy as file" Tag="File" Click="CopyTrack_Click">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE8A5;"/>
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>
									</SplitMenuFlyoutItem>

									<MenuFlyoutItem Text="Download"
										Click="DownloadTrack_Click"
										Visibility="{Binding IsHidden, Converter={StaticResource InvertBoolConverter}}">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE896;"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>

									<MenuFlyoutSeparator Visibility="{Binding IsHidden, Converter={StaticResource InvertBoolConverter}}"/>

									<MenuFlyoutItem Text="{Binding DeleteActionText}"
										Foreground="{Binding DeleteActionForeground}"
										IsEnabled="{Binding CanDelete}"
										Click="DeleteTrack_Click">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="{Binding DeleteActionIcon}"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>

									<MenuFlyoutSeparator Visibility="{x:Bind IsDeveloperModeEnabled}"/>

									<MenuFlyoutItem Text="Copy Track ID"
										Visibility="{x:Bind IsDeveloperModeEnabled}"
										Click="CopyTrackID_Click">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE8C8;"/>
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>

								</MenuFlyout>
							</Border.Resources>
							<Border.ContextFlyout>
								<StaticResource ResourceKey="TrackMenu"/>
							</Border.ContextFlyout>

							<StackPanel>

								<Grid Height="150">
									<Image Source="{Binding DisplayThumbnailURL}"
										Stretch="UniformToFill"/>

									<Image Source="ms-appx:///Assets/featured-badge.png"
										Height="32"
										HorizontalAlignment="Left"
										Margin="8"
										ToolTipService.ToolTip="Featured"
										VerticalAlignment="Top"
										Visibility="{Binding IsFeatured}"
										Width="24"/>

									<Grid
										Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
										CornerRadius="4"
										HorizontalAlignment="Right"
										Margin="8"
										Opacity="0.8"
										VerticalAlignment="Bottom"
										Visibility="{Binding IsHidden}">
										<Border
											Background="{ThemeResource SystemFillColorCriticalBrush}"
											Opacity="0.2"
											HorizontalAlignment="Stretch"
											VerticalAlignment="Stretch"/>

										<StackPanel Orientation="Horizontal" Padding="5,2" Spacing="4">
											<FontIcon Glyph="&#xED1A;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
											<TextBlock
												Text="Hidden"
												FontSize="12"
												FontWeight="SemiBold"
												Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
										</StackPanel>
									</Grid>

									<Border
										Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
										CornerRadius="4"
										HorizontalAlignment="Right"
										Margin="8"
										Opacity=".6"
										Padding="5,2"
										VerticalAlignment="Bottom"
										Visibility="{Binding IsHidden, Converter={StaticResource InvertBoolConverter}}">

										<TextBlock
											Text="{Binding BestTime}"
											FontSize="12"
											FontWeight="SemiBold"/>

									</Border>
								</Grid>

								<Grid Padding="16">

									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<StackPanel Spacing="4">

										<TextBlock
											Text="{Binding Title}"
											FontSize="15"
											FontWeight="SemiBold"
											TextTrimming="CharacterEllipsis"/>

										<StackPanel
											Orientation="Horizontal"
											Spacing="4"
											Opacity="0.6">

											<FontIcon
												Glyph="&#xE8E1;"
												FontSize="12"
												VerticalAlignment="Center"/>

											<TextBlock
												Text="{Binding Rating}"
												FontSize="12"
												VerticalAlignment="Center"/>

										</StackPanel>

										<StackPanel
											Orientation="Horizontal"
											Spacing="4"
											Opacity="0.6">

											<FontIcon
												Glyph="&#xE787;"
												FontSize="12"
												VerticalAlignment="Center"/>

											<TextBlock
												Text="{Binding PublishedTimeAgo}"
												FontSize="12"
												VerticalAlignment="Center"
												Visibility="{Binding PublishedTimestampLoaded}"/>

											<ProgressRing
												Width="12"
												Height="12"
												VerticalAlignment="Center"
												IsActive="{Binding PublishedTimestampLoaded, Converter={StaticResource InvertBoolConverter}}"/>
										</StackPanel>

									</StackPanel>

									<Button
										Grid.Column="1"
										Flyout="{StaticResource TrackMenu}"
										Width="32"
										Height="32"
										Padding="0"
										Style="{StaticResource SubtleButtonStyle}"
										VerticalAlignment="Center">

										<FontIcon Glyph="&#xE712;"/>

									</Button>

								</Grid>

							</StackPanel>

						</Border>

					</DataTemplate>
				</GridView.ItemTemplate>

			</GridView>

		</RefreshContainer>
	</Grid>
</Page>