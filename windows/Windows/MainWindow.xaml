<Window x:Class="AccountCentre.Windows.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:AccountCentre.Components"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Window.SystemBackdrop>
		<MicaBackdrop/>
	</Window.SystemBackdrop>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TitleBar x:Name="TitleBar"
			Title="Account Centre"
			Subtitle="By Calculus"
			IsBackButtonVisible="False"
			IsPaneToggleButtonVisible="True"
			PaneToggleRequested="TitleBar_PaneToggleRequested">
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="ms-appx:///Assets/app.ico" />
			</TitleBar.IconSource>
			<TitleBar.LeftHeader>
				<Button x:Name="RefreshButton"
					Height="44"
					Margin="0,0,16,0"
					Style="{StaticResource SubtleButtonStyle}"
					Click="TitleBar_RefreshRequested"
					Visibility="Collapsed"
					ToolTipService.ToolTip="Refresh Page">
					<local:AnimatedRefreshIcon x:Name="RefreshIcon"/>
				</Button>
			</TitleBar.LeftHeader>
			<TitleBar.Content>
				<AutoSuggestBox x:Name="SearchBar" PlaceholderText="Search"
					QueryIcon="Find" VerticalAlignment="Center" Width="300"
					TextChanged="TitleBar_SearchTextChanged"
					SuggestionChosen="TitleBar_SearchSuggestionChosen"/>
			</TitleBar.Content>
			<TitleBar.RightHeader>
				<Button x:Name="ProfileButton"
					Style="{StaticResource SubtleButtonStyle}"
					BorderThickness="0"
					CornerRadius="16"
					Width="30"
					Height="30"
					Padding="0">

					<PersonPicture x:Name="PersonPicture"
						Width="30"
						Height="30">
						<PersonPicture.RenderTransform>
							<CompositeTransform
								x:Name="PersonPictureTransform"
								CenterX="15"
								CenterY="15"/>
						</PersonPicture.RenderTransform>
					</PersonPicture>

					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight">
							<local:AccountFlyoutItem x:Name="AccountHeader" User="{x:Bind Session.User}">
								<MenuFlyoutItem.Template>
									<ControlTemplate TargetType="MenuFlyoutItem">
										<StackPanel
											Orientation="Horizontal"
											Padding="12"
											Spacing="12">
											<PersonPicture
													x:Name="FlyoutPersonPicture"
													Width="48"
													Height="48"/>

											<StackPanel Spacing="2" VerticalAlignment="Center">
													<TextBlock
														x:Name="FlyoutName"
														FontSize="16"
														FontWeight="SemiBold"
														IsTextSelectionEnabled="True"/>

													<TextBlock
														x:Name="FlyoutEmail"
														FontSize="11"
														Opacity="0.6"
														IsTextSelectionEnabled="True"/>
												</StackPanel>
										</StackPanel>
									</ControlTemplate>
								</MenuFlyoutItem.Template>
							</local:AccountFlyoutItem>

							<MenuFlyoutSeparator/>

							<MenuFlyoutItem Text="Profile" Click="OpenProfile_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8A7;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

							<MenuFlyoutItem Text="Settings" Click="OpenSettings_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE713;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

							<MenuFlyoutSeparator/>

							<SplitMenuFlyoutItem x:Name="SwitchAccounts"
								Text="Switch accounts"
								Click="SwitchAccounts_Click">
								<SplitMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8AB;"/>
								</SplitMenuFlyoutItem.Icon>
							</SplitMenuFlyoutItem>

							<MenuFlyoutSeparator/>

							<MenuFlyoutItem Text="Sign out"
								Foreground="{ThemeResource SystemFillColorCriticalBrush}"
								Click="Logout_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF3B1;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

							<MenuFlyoutSeparator Visibility="{x:Bind IsDeveloperModeEnabled}"/>

							<MenuFlyoutItem Text="Copy User ID"
								Visibility="{x:Bind IsDeveloperModeEnabled}"
								Click="CopyUserID_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8C8;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</TitleBar.RightHeader>
		</TitleBar>

		<NavigationView
			x:Name="NavigationView"
			Grid.Row="1"
			IsBackButtonVisible="Collapsed"
			IsPaneToggleButtonVisible="False"
			IsSettingsVisible="True"
			ItemInvoked="NavigationView_ItemInvoked"
			PaneDisplayMode="Left"
			CompactPaneLength="48"
			OpenPaneLength="260">
			<NavigationView.MenuItems>
				<NavigationViewItem
					Content="Home"
					Icon="Home"
					IsSelected="True"
					Tag="Home"/>

				<NavigationViewItem
					Content="Comments"
					IsEnabled="False">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE8F2;"/>
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					Content="Created"
					Tag="Created">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE771;"/>
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					Content="Friends"
					Tag="Friends">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE902;"/>
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					Content="Notifications"
					Tag="Notifications">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xEA8F;"/>
					</NavigationViewItem.Icon>
					<NavigationViewItem.InfoBadge>
						<InfoBadge x:Name="NotificationInfoBadge" Visibility="Collapsed"/>
					</NavigationViewItem.InfoBadge>
				</NavigationViewItem>

				<NavigationViewItem
					Content="Races"
					Tag="Races">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE7C1;"/>
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.MenuItems>
			<NavigationView.FooterMenuItems>
				<NavigationViewItem
					Content="Sponsor"
					Tag="https://github.com/sponsors/Calculamatrise"
					SelectsOnInvoked="False">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xEB51;" Foreground="#C96198"/>
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.FooterMenuItems>
			<NavigationView.Content>
				<Frame x:Name="ContentFrame"
					Navigating="ContentFrame_Navigating"
					Navigated="ContentFrame_Navigated"/>
			</NavigationView.Content>
		</NavigationView>
	</Grid>
</Window>