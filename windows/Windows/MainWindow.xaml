<Window x:Class="AccountCentre.Windows.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:AccountCentre.Components"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Window.SystemBackdrop>
		<MicaBackdrop/>
	</Window.SystemBackdrop>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TitleBar x:Name="TitleBar"
			Title="Account Centre"
			Subtitle="By Calculus"
			IsBackButtonVisible="False"
			IsPaneToggleButtonVisible="True"
			PaneToggleRequested="TitleBar_PaneToggleRequested">
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="ms-appx:///Assets/app.ico" />
			</TitleBar.IconSource>
			<TitleBar.LeftHeader>
				<Button x:Name="RefreshButton"
					Height="44"
					Margin="0,0,16,0"
					Style="{StaticResource SubtleButtonStyle}"
					Click="TitleBar_RefreshRequested"
					Visibility="Collapsed"
					ToolTipService.ToolTip="Refresh Page">
					<local:AnimatedRefreshIcon x:Name="RefreshIcon"/>
				</Button>
			</TitleBar.LeftHeader>
			<TitleBar.Content>
				<AutoSuggestBox x:Name="SearchBar" PlaceholderText="Search"
					QueryIcon="Find" VerticalAlignment="Center" Width="300"
					TextChanged="TitleBar_SearchTextChanged"
					SuggestionChosen="TitleBar_SearchSuggestionChosen"/>
			</TitleBar.Content>
			<TitleBar.RightHeader>
				<Button
					Background="Transparent"
					BorderThickness="0"
					CornerRadius="16"
					Width="32"
					Height="32"
					Padding="0"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center">

					<PersonPicture x:Name="PersonPicture"
						Width="32"
						Height="32" />

					<Button.Flyout>
						<MenuFlyout Placement="BottomEdgeAlignedRight" Opened="AccountFlyout_Opened">
							<local:AccountFlyoutItem x:Name="AccountHeader">
								<MenuFlyoutItem.Template>
									<ControlTemplate TargetType="MenuFlyoutItem">

										<StackPanel
											Orientation="Horizontal"
											Padding="12"
											Spacing="12">
											<PersonPicture
													x:Name="FlyoutPersonPicture"
													Width="48"
													Height="48" />

											<StackPanel Spacing="2" VerticalAlignment="Center">

													<TextBlock
														x:Name="FlyoutName"
														FontSize="16"
														FontWeight="SemiBold"
														IsTextSelectionEnabled="True"/>

													<TextBlock
														x:Name="FlyoutEmail"
														FontSize="11"
														Opacity="0.6"
														IsTextSelectionEnabled="True"/>

												</StackPanel>
										</StackPanel>

									</ControlTemplate>
								</MenuFlyoutItem.Template>
							</local:AccountFlyoutItem>

							<MenuFlyoutSeparator/>

							<MenuFlyoutItem Text="Profile" Click="OpenProfile_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8A7;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

							<MenuFlyoutItem Text="Settings" Click="OpenSettings_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE713;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

							<MenuFlyoutSeparator />

							<MenuFlyoutItem Text="Sign out"
								Foreground="{ThemeResource SystemFillColorCriticalBrush}"
								Click="Logout_Click">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xF3B1;"/>
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>

						</MenuFlyout>
					</Button.Flyout>

				</Button>
			</TitleBar.RightHeader>
		</TitleBar>

		<NavigationView
			x:Name="NavigationView"
			Grid.Row="1"
			IsBackButtonVisible="Collapsed"
			IsPaneToggleButtonVisible="False"
			IsSettingsVisible="True"
			ItemInvoked="NavigationView_ItemInvoked"
			PaneDisplayMode="Left"
			CompactPaneLength="48"
			OpenPaneLength="260">
			<NavigationView.MenuItems>

				<NavigationViewItem
					Content="Home"
					Icon="Home"
					IsSelected="True"
					Tag="Home" />

				<NavigationViewItem
					Content="Created"
					Tag="Created">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE771;"/>
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					Content="Friends"
					Tag="Friends">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE902;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

				<NavigationViewItem
					Content="Races"
					Tag="Races">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE7C1;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

			</NavigationView.MenuItems>
			<NavigationView.FooterMenuItems>

				<NavigationViewItem
					Content="Sponsor"
					Tag="https://github.com/sponsors/Calculamatrise"
					SelectsOnInvoked="False">
					<NavigationViewItem.Icon>
						<FontIcon
							FontFamily="Segoe Fluent Icons"
							Glyph="&#xEB51;"
							Foreground="#C96198" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>

			</NavigationView.FooterMenuItems>
			<NavigationView.Content>

				<Frame x:Name="ContentFrame"/>

			</NavigationView.Content>
		</NavigationView>
	</Grid>
</Window>