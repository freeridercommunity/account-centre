<Window x:Class="AccountCentre.Windows.AuthWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Window.SystemBackdrop>
		<MicaBackdrop/>
	</Window.SystemBackdrop>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TitleBar x:Name="TitleBar"
			Title="Free Rider HD"
			Subtitle="Login"
			IsBackButtonVisible="False"
			IsPaneToggleButtonVisible="False">
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="ms-appx:///Assets/app.ico"/>
			</TitleBar.IconSource>
		</TitleBar>

		<StackPanel
			Grid.Row="1"
			Padding="40,32"
			Spacing="16"
			VerticalAlignment="Center">

			<AutoSuggestBox x:Name="UsernameBox" Header="Username" PlaceholderText="Enter your username"
				TextChanged="AutoSuggestBox_TextChanged"/>
			<PasswordBox x:Name="PasswordBox" Header="Password" PlaceholderText="Enter your password"
				PasswordChanged="PasswordBox_PasswordChanged"/>

			<InfoBar x:Name="ErrorInfoBar"
				Severity="Error"
				IsOpen="False"
				IsClosable="True"/>

			<Button x:Name="LoginButton" Style="{StaticResource AccentButtonStyle}" Content="Login"
				HorizontalAlignment="Stretch" IsEnabled="False" Click="Login_Click"/>

		</StackPanel>
	</Grid>
</Window>