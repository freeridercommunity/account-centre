<Window x:Class="AccountCentre.Windows.AuthWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:behaviors="using:AccountCentre.Behaviors"
	xmlns:models="using:AccountCentre.Models"
	xmlns:networkingModels="using:AccountCentre.Networking.Models">
	<Window.SystemBackdrop>
		<MicaBackdrop/>
	</Window.SystemBackdrop>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TitleBar x:Name="TitleBar"
			Title="Free Rider HD"
			Subtitle="Login"
			IsBackButtonVisible="False"
			IsPaneToggleButtonVisible="False">
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="ms-appx:///Assets/app.ico"/>
			</TitleBar.IconSource>
		</TitleBar>

		<ScrollView Grid.Row="1" x:Name="AuthForm"
			Visibility="Collapsed">
			<StackPanel
				Padding="40,32"
				Spacing="12"
				VerticalAlignment="Center">
				<AutoSuggestBox x:Name="UsernameBox" Header="Username" PlaceholderText="Enter your username"
					TextChanged="UsernameBox_TextChanged"
					behaviors:UserSuggestBehavior.Enabled="True">
					<AutoSuggestBox.ItemTemplate>
						<DataTemplate x:DataType="networkingModels:UMentionData">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PersonPicture ProfilePicture="{x:Bind AvatarURL}"
									CornerRadius="16"
									Width="24"
									Height="24"/>

								<TextBlock Text="{x:Bind DisplayName}"
									VerticalAlignment="Center" />
							</StackPanel>
						</DataTemplate>
					</AutoSuggestBox.ItemTemplate>
				</AutoSuggestBox>
				<PasswordBox x:Name="PasswordBox" Header="Password" PlaceholderText="Enter your password"
					PasswordChanged="PasswordBox_PasswordChanged"/>
				<CheckBox x:Name="RememberMe" Content="Stay signed in"/>

				<InfoBar x:Name="ErrorInfoBar"
					Severity="Error"
					IsOpen="False"
					IsClosable="True"/>

				<Button x:Name="LoginButton" Style="{StaticResource AccentButtonStyle}" Content="Login"
					HorizontalAlignment="Stretch" IsEnabled="False" Click="Login_Click"/>
			</StackPanel>
		</ScrollView>

		<Grid x:Name="ContinueAs" Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Center"
			Visibility="Collapsed">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<GridView x:Name="SessionsGrid"
				ItemsSource="{x:Bind UserSessions}"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Center"
				IsItemClickEnabled="True"
				ItemClick="SessionsGrid_ItemClick"
				Padding="32,16"
				SelectionMode="None"
				VerticalContentAlignment="Center"
				ContainerContentChanging="SessionsGrid_ContainerContentChanging">
				<GridView.Resources>
					<MenuFlyout x:Key="UserSessionMenu">
						<MenuFlyoutItem Text="View profile" Click="ViewProfile_Click">
							<MenuFlyoutItem.Icon>
								<FontIcon Glyph="&#xE8A7;"/>
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>

						<MenuFlyoutSeparator/>

						<MenuFlyoutItem Text="Forget"
							Foreground="{ThemeResource SystemFillColorCriticalBrush}"
							Click="ForgetSession_Click">
							<MenuFlyoutItem.Icon>
								<FontIcon Glyph="&#xE74D;"/>
							</MenuFlyoutItem.Icon>
						</MenuFlyoutItem>
					</MenuFlyout>
				</GridView.Resources>

				<GridView.ItemContainerStyle>
					<Style TargetType="GridViewItem"
						BasedOn="{StaticResource DefaultGridViewItemStyle}">
						<Setter Property="ContextFlyout"
							Value="{StaticResource UserSessionMenu}"/>
					</Style>
				</GridView.ItemContainerStyle>

				<GridView.ItemTemplate>
					<DataTemplate x:DataType="models:User">
						<StackPanel Width="150">
							<Grid Height="128">
								<PersonPicture ProfilePicture="{Binding DisplayAvatarURL}"/>

								<Border Background="{ThemeResource SystemFillColorAttentionBrush}"
									CornerRadius="16"
									Height="32" Width="32"
									HorizontalAlignment="Left" VerticalAlignment="Top"
									Margin="8"
									ToolTipService.ToolTip="Signed in"
									Visibility="{x:Bind IsAuthenticated}">
									<FontIcon Glyph="&#xE785;"
										HorizontalAlignment="Stretch"
										VerticalAlignment="Stretch"/>
								</Border>
							</Grid>

							<TextBlock Text="{Binding DisplayName}"
								FontSize="15" FontWeight="SemiBold"
								HorizontalAlignment="Center"
								Padding="16,0,16,16"
								TextTrimming="CharacterEllipsis"
								VerticalAlignment="Center"/>
						</StackPanel>
					</DataTemplate>
				</GridView.ItemTemplate>
			</GridView>

			<Button Content="Not you?" Style="{StaticResource SubtleButtonStyle}"
				Grid.Row="1"
				HorizontalAlignment="Center"
				Margin="8"
				Click="NotYou_Click"/>
		</Grid>

		<ProgressRing Grid.Row="1" x:Name="ProgressRing"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"/>
	</Grid>
</Window>